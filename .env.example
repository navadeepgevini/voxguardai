# ========================================================
# VoxGuard AI — Root Environment Variables Template
# Copy this file to .env or .env.local for local development.
# NEVER commit real credentials, API keys, or secrets to Git.
# ========================================================

# --- Backend Application (FastAPI) ---
# Cloud PostgreSQL URL (e.g. Neon, Supabase, Render, AWS RDS)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
# If left empty, VoxGuard automatically falls back to local SQLite (backend/voxguard.db)
DATABASE_URL=sqlite:///backend/voxguard.db

# Application Secret Key for JWT / Session Signing (64-character hex string)
SECRET_KEY=change_me_to_a_secure_random_64_char_hex_string

# Allowed CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Backend Environment Mode (development / production)
ENVIRONMENT=development

# --- Frontend Application (Next.js 16) ---
# Public URL for the FastAPI backend microservice
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# --- Email Alert Notifications (Resend API) ---
# Resend API key for deepfake incident alert emails
# Get a free key at https://resend.com
RESEND_API_KEY=re_placeholder_api_key_here

# Verified Sender Email Address (e.g. alerts@yourdomain.com or onboarding@resend.dev)
ALERT_FROM_EMAIL=onboarding@resend.dev

# Default recipient for deepfake security alerts
ALERT_TO_EMAIL=security-team@example.com

# --- Developer Tooling & Integrations (Optional) ---
# Context7 Documentation Retrieval API Key (https://context7.com/dashboard)
CONTEXT7_API_KEY=ctx7_placeholder_api_key_here

# DBHub Database Gateway DSN (defaults to local SQLite if unset)
DBHUB_DSN=sqlite://backend/voxguard.db

# Chrome DevTools Remote Debugging Port (optional, default: 9222)
CHROME_DEBUG_PORT=9222
