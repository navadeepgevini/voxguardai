# VoxGuard / EchoGuard — root environment template (placeholders only)
# Copy to .env or .env.local. NEVER commit real secrets.

# Frontend → Backend
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Backend (also supported in backend/.env)
DATABASE_URL=
SECRET_KEY=change_this_to_a_secure_random_64_char_hex_string
ALLOWED_ORIGINS=http://localhost:3000
ENVIRONMENT=development

# Demo controls (local only — keep off in real production)
# ALLOW_DEMO_USERS=true
# ALLOW_DEMO_PAYMENTS=true
# ALLOW_DEMO_WS=true

# Optional MCP / developer tooling
CONTEXT7_API_KEY=ctx7_placeholder_api_key_here
DBHUB_DSN=sqlite:///./backend/voxguard.db
CHROME_DEBUG_PORT=9222

# Optional notifications
# RESEND_API_KEY=re_placeholder_api_key_here
# ALERT_FROM_EMAIL=onboarding@resend.dev
# ALERT_TO_EMAIL=security-team@example.com
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=alerts@voxguard.security

# Optional detector backend (sklearn default; torch after GPU training)
# VOXGUARD_DETECTOR_BACKEND=sklearn
# VOXGUARD_TORCH_CHECKPOINT=
