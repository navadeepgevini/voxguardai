{
  "mcpServers": {
    "chrome-devtools-mcp": {
      "enabled": true,
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest"],
      "env": {},
      "notes": "Requires Chrome remote debugging. Never log cookies/tokens."
    },
    "dbhub": {
      "enabled": true,
      "command": "npx",
      "args": [
        "-y",
        "@bytebase/dbhub@latest",
        "--dsn",
        "${DBHUB_DSN}",
        "--readonly"
      ],
      "env": {
        "DBHUB_DSN": "${DBHUB_DSN}"
      },
      "notes": "Default local DSN example: sqlite:///./backend/voxguard.db — readonly only."
    },
    "context7": {
      "enabled": true,
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://mcp.context7.com/mcp",
        "--header",
        "Authorization: Bearer ${CONTEXT7_API_KEY}"
      ],
      "env": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      },
      "notes": "Optional. Without CONTEXT7_API_KEY, Documentation Research Agent uses docs/ + web search."
    },
    "serena": {
      "enabled": true,
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--project",
        "."
      ],
      "env": {},
      "notes": "Optional. Requires uv. Falls back to Grep/Glob/Read."
    }
  },
  "application_runtime_depends_on_mcp": false
}
