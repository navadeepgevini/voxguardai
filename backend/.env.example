# VoxGuard Backend Configuration Template
# Copy this file to .env and fill in your details:
# NEVER commit your actual .env file to GitHub!

# Cloud PostgreSQL Database URL (e.g. Neon, Supabase, Render, Railway, AWS RDS)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
# If left empty, VoxGuard will fallback to local SQLite (backend/voxguard.db)
DATABASE_URL=postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/voxguard?sslmode=require

# Optional: Supabase pooler region when rewriting db.<ref>.supabase.co hosts
# SUPABASE_POOLER_REGION=aws-0-ap-northeast-2

# Application Secret Key (reserved for future signing; sessions are DB opaque tokens today)
SECRET_KEY=change_this_to_a_secure_random_64_char_hex_string

# Allowed CORS Origins (comma-separated). Required in production.
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend-deployment.vercel.app

# Environment Mode: development | production
ENVIRONMENT=development

# Demo controls (NEVER enable in real production with public exposure)
# ALLOW_DEMO_USERS=true          # seed operator/evaluator accounts
# ALLOW_DEMO_PAYMENTS=true       # allow UTR self-attest / zero-price topup (local demos only)
# ALLOW_DEMO_WS=true             # allow unauthenticated WebSocket demo frames

# SMTP (optional; otherwise demo/simulated delivery)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=alerts@voxguard.security
